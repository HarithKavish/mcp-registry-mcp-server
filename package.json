{
    "name": "mcp-client",
    "displayName": "harith-context-mcp",
    "description": "MCP server manifest for harith-context-mcp (stdio)",
    "publisher": "harithkavish",
    "version": "0.0.1",
    "main": "./extension.js",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/HarithKavish/mcp-registry-mcp-server.git"
    },
    "bugs": {
        "url": "https://github.com/HarithKavish/mcp-registry-mcp-server/issues"
    },
    "homepage": "https://github.com/HarithKavish/mcp-registry-mcp-server",
    "license": "MIT",
    "workspaces": [
        "packages/*"
    ],
    "keywords": [
        "mcp",
        "model-context-protocol",
        "ai-agent",
        "tool-server",
        "context7",
        "camera"
    ],
    "dependencies": {
        "axios": "^1.20.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "zod": "^4.5.4"
    },
    "contributes": {
        "mcpServers": [
            {
                "name": "harith-context-mcp",
                "type": "stdio",
                "command": "npx",
                "args": [
                    "-y",
                    "@harith/context-mcp",
                    "--transport",
                    "stdio"
                ]
            },
            {
                "name": "harith-camera-mcp",
                "type": "stdio",
                "command": "npx",
                "args": [
                    "-y",
                    "@harith/camera-mcp"
                ]
            }
        ]
    }
}