{
    "name": "mcp-client",
    "displayName": "HarithKavish MCP Tools",
    "description": "Real MCP tools (context lookup, webcam capture) registered with VS Code's MCP client, plus a registry browser for other MCP servers.",
    "publisher": "harithkavish",
    "version": "0.1.0",
    "main": "./extension.js",
    "engines": {
        "vscode": "^1.105.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "categories": [
        "Other",
        "AI"
    ],
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/HarithKavish/mcp-registry-mcp-server.git"
    },
    "bugs": {
        "url": "https://github.com/HarithKavish/mcp-registry-mcp-server/issues"
    },
    "homepage": "https://github.com/HarithKavish/mcp-registry-mcp-server",
    "license": "MIT",
    "workspaces": [
        "packages/*"
    ],
    "keywords": [
        "mcp",
        "model-context-protocol",
        "ai-agent",
        "tool-server",
        "context7",
        "camera"
    ],
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "zod": "^4.5.4"
    },
    "contributes": {
        "mcpServerDefinitionProviders": [
            {
                "id": "harithMcpTools",
                "label": "HarithKavish MCP Tools"
            }
        ],
        "commands": [
            {
                "command": "mcp.listServers",
                "title": "MCP: List Registry Servers",
                "category": "HarithKavish MCP"
            },
            {
                "command": "mcp.installServer",
                "title": "MCP: Install Server From Registry",
                "category": "HarithKavish MCP"
            },
            {
                "command": "mcp.startServer",
                "title": "MCP: Start Local Server (HTTP)",
                "category": "HarithKavish MCP"
            },
            {
                "command": "mcp.stopServer",
                "title": "MCP: Stop Local Server (HTTP)",
                "category": "HarithKavish MCP"
            },
            {
                "command": "mcp.showServerLogs",
                "title": "MCP: Show Server Logs",
                "category": "HarithKavish MCP"
            },
            {
                "command": "mcp.connectServer",
                "title": "MCP: Connect to Server (HTTP)",
                "category": "HarithKavish MCP"
            }
        ]
    }
}